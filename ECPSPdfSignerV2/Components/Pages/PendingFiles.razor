@page "/pendingFiles"

@using CommunityToolkit.Maui.Views
@using ECPSPdfSignerV2.Components.MAUI_Pages
@using ECPSPdfSignerV2.Data
@using ECPSPdfSignerV2.Model
@using ECPSPdfSignerV2.Services
@using EcpsService.Models.DTO
@using Syncfusion.Pdf
@using Syncfusion.Pdf.Graphics
@using Syncfusion.Pdf.Parsing
@using System.Security.Cryptography.X509Certificates
@using Syncfusion.Pdf.Security


@inject IJSRuntime JS
@implements IDisposable
@inject APIService service 
@inject NavigationManager navigationManager

<div class="card-header">
    <h3 style="color: #052A49;"> <strong> Sign Pending Files</strong></h3>
</div>


<div class="card p-2 mt-5 mb-5" style="display: @(state == FileState.ShowList ? "display" : "none")">


    @if (loading)
    {
        <button class="btn btn-primary btn-lg d-flex justify-content-between align-items-center" type="button" disabled>
            <strong>Loading Files</strong>
            <span class="spinner-border spinner-border ms-auto" role="status" aria-hidden="true"></span>
        </button>
    }
    else
    {
        <table id="files_table" class="table table-striped table-bordered table-hover mb-0" style="width:100%">
            <thead>
                <tr>
                    <th class="text-center text-info"> File No </th>
                    <th class="text-center text-info"> Case Type </th>
                    <th class="text-center text-info"> Zone-SubZone </th>
                    <th class="text-center text-info"> Floor </th>
                    <th class="text-center text-info"> Meeting No </th>
                    <th></th>
                </tr>
            </thead>
            @if (UnsignedFiles != null)
            {
                <tbody>
                    @foreach (var file in UnsignedFiles)
                    {
                        <tr>
                            <td class="text-center">@file.fileNo</td>
                            <td class="text-center">@file.caseType</td>
                            <td class="text-center">@file.zoneSubZone</td>
                            <td class="text-center">@file.numberOfFloors</td>
                            <td class="text-center">@file.meetingNo</td>
                            <td class="text-center">@file.subZoneID</td>
                        </tr>
                    }
                </tbody>
            }

        </table>
    }

</div>
<div style="display: @(state == FileState.ShowList ? "display" : "none")">
    <br />
    <br />
    <br />
</div>

<div class="card p-3 mt-5 mb-5" style="display: @(state == FileState.Downloading ? "display" : "none")">

        <button class="btn btn-primary" type="button" disabled>
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            Downloading...
        </button>
</div>

<div class="card p-3 mt-5 mb-5" style="display: @(state == FileState.PDFSigning ? "display" : "none")">

    <button class="btn btn-primary" type="button" disabled>
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        Signing File...
    </button>
</div>

<div class="card p-3 mt-5 mb-5" style="display: @(state == FileState.Uploading == true ? "display" : "none")">
    <h2 class="text-center text-success"> <strong>File Uploading</strong></h2>
    <br><br>

    <br /><br />
    <button class="btn btn-primary" type="button" disabled>
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        Uploading...
    </button>
    <br />
    <h5 class="text-center text-secondary">Please wait while the upload is complete</h5>
</div>

<div class="card p-3 mt-5 mb-5" style="display: @(state == FileState.Uploaded == true ? "display" : "none")">
    <h2 class="text-center text-success"> <strong>Process Completed</strong></h2>
    <br><br>
    <div class="row justify-content-center">
        <div class="col-1">
            <img src="https://img.icons8.com/color/96/000000/ok--v2.png" class="fit-image">
        </div>
    </div>
    <br><br>
    <div class="row justify-content-center">
        <div class="col-4">
            <h4 class="text-secondary">The File is digitally signed and has been updated in the system </h4>
        </div>
    </div>
    <br />
    <br />
    <div class="mt-3 mb-3" style="margin-left: auto;">
        <button class="btn btn-outline-primary px-4" @onclick="HidePDF">Back To Files</button>
    </div>

</div>

@code {

    List<SignPendingFileDTO>? UnsignedFiles { get; set; }
    private bool internetConnection { get; set; }
    private bool loading = true;

    private FileState state { get; set; }

    protected override async void OnInitialized()
    {
        await RefreshData();
        loading = false;
        state = FileState.ShowList;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (UnsignedFiles != null)
        {
            if (firstRender)
            {
                await JS.InvokeVoidAsync("window.DataTables1.buildDataTable", DotNetObjectReference.Create(this));
            }
            else
            {
                await JS.InvokeVoidAsync("window.DataTables1.destroyDataTable");
                await JS.InvokeVoidAsync("window.DataTables1.buildDataTable", DotNetObjectReference.Create(this));
            }
        }
    }

    public async void Dispose()
    {
        await JS.InvokeVoidAsync("window.DataTables1.destroyDataTable");
    }

    private async Task RefreshData()
    {
        if (Connectivity.NetworkAccess != NetworkAccess.Internet)
        {
            internetConnection = false;
        }
        else
        {
            internetConnection = true;
        }
        UnsignedFiles = await service.GetPendingFilesAsync();
    }

    [JSInvokable]
    public async void SelectRow(string pdfUrl, Guid subZoneID)
    {
        loading = true;
        state = FileState.Downloading;
        StateHasChanged();

        var docName = await service.DownloadDocument(pdfUrl); 
        loading = false;

        if (docName == null)
        {
            await App.Current.MainPage.DisplayAlert("File Not Found !", "Inform Authority with File No", "Ok");
            navigationManager.Refresh();
            return;
        }      

        var localFilePath = Path.Combine(Utility.GetFolderPath(), docName);

        // Show PDF Before Signing
        if (!File.Exists(localFilePath))
        {
            await App.Current.MainPage.DisplayAlert("Download Failed !", "File Couldn't be downloaded. Try again", "Ok");
            navigationManager.Refresh();
            return;
        }
        

        var proceedToSignPermission = await ShowUnsignedPDF(localFilePath);

        if (proceedToSignPermission == false)
        {
            state = FileState.ShowList;
            HidePDF();
            return;
        }

        // Sign PDF
        state = FileState.PDFSigning;
        StateHasChanged();
        var SignSuccessful = await ProceedToSign(localFilePath, subZoneID);

        if (SignSuccessful)
        {
            state = FileState.PDFSigned;
            StateHasChanged();
            ShowSignedPDF(localFilePath);
        }
        else
        {
            await App.Current.MainPage.DisplayAlert("", "Corrupted File!", "Ok");
            navigationManager.Refresh();
        }
    }

    private async Task<bool> ShowUnsignedPDF(string localFilePath)
    {
        if (!File.Exists(localFilePath))
            return false;

        var result = await App.Current.MainPage.ShowPopupAsync(new PdfPopUp(localFilePath, "Back To Files", "Proceed To Sign",  false));

        if (result is bool boolResult && boolResult)
        {
            return true;
        }
        return false;
    }

    private async void ShowSignedPDF(string localFilePath)
    {
        if (!File.Exists(localFilePath))
            return;

        var result = await App.Current.MainPage.ShowPopupAsync(new PdfPopUp(localFilePath, "", "Complete", true));

        if (result is bool boolResult)
        {
            if (boolResult)
            {
                UploadSignedPDF(localFilePath);
            }
        }
    }

    private void HidePDF()
    {
        navigationManager.Refresh();
    }

    private async void UploadSignedPDF(string localFilePath){
        state = FileState.Uploading;
        StateHasChanged();

        string fileNo = Path.GetFileNameWithoutExtension(localFilePath);

        await service.UploadSignedPDF(localFilePath, fileNo);

        // Delete File from local storage after Uploading
        Utility.DeleteFile(localFilePath);

        state = FileState.Uploaded;
        StateHasChanged();
    }

    private async Task<bool> ProceedToSign(string localFilePath, Guid subZoneID)
    {
        string logoPath = Path.Combine(SD._rootPath, "Images", "rajukLogo.png");

        if (!File.Exists(logoPath) || !File.Exists(localFilePath))
            return false;

        var data = await service.GetMembersDesignationFlowAsync(subZoneID);
        return await PDFSigner.SignPDF(localFilePath, localFilePath, logoPath, data, SD._CurrentUserRole);
    }

    enum FileState{
        ShowList,
        Downloading,
        PDFSigning,
        PDFSigned,
        Uploading,
        Uploaded
    }
}
