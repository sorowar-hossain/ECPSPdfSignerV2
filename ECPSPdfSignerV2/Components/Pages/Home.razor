@page "/"

@using ECPSPdfSignerV2.Data
@using ECPSPdfSignerV2.Services
@inject AppState appState
@inject APIService service
@implements IDisposable

@if (appState.LoggedIn)
{
    <div class="card p-3">

        <h3 class="text-center" style="color: #052A49;"> <b> Welcome to PQSigner </b></h3>
        <br />
        <p class="text-secondary">
            <b>
                PQSigner is a desktop application designed to simplify the process of signing official documents. To use this application, you need to have a digital certificate connected to your local machine.
            </b>
        </p>
        <p class="text-secondary">
            <b>
                To know more about the Application, go to <a href="/about"> About </a> Tab.
            </b>
        </p>

    </div>
}
else
{
    <Login />
}

<style>
    p {
        font-size: 20px;
    }
</style>
@code {
    protected override void OnInitialized()
    {
        appState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        appState.OnChange -= StateHasChanged;
    }
}